import pandas as pd

from sklearn.datasets import load_iris

from sklearn.model_selection import train_test_split

from sklearn.neighbors import KNeighborsClassifier

from sklearn.metrics import accuracy_score

from sklearn.linear_model import LogisticRegression

from sklearn.metrics import confusion_matrix, classification_report

import matplotlib.pyplot as plt

print("--------------------")

X, y = load_iris(return_X_y=True)

X_tr, X_te, y_tr, y_te = train_test_split(
    X, y, test_size=.25, random_state=0
)

knn = KNeighborsClassifier(3).fit(X_tr, y_tr)

pred = knn.predict(X_te)

print(pred[:5], y_te[:5], 'accuracy:', accuracy_score(y_te, pred))

print("--------------------")

print(X_te[:3])

print(knn.kneighbors(X_te[:1]))

print("--------------------")

distances, indexes = knn.kneighbors(X_te[:1])

print('3 ближайших цветка:')

for i in indexes[0]:
    print(X_tr[i], 'класс:', y_tr[i])

print('Классы соседей:', y_tr[indexes[0]])

print('Предсказанный класс:', knn.predict(X_te[:1])[0])

plt.scatter(X_tr[:, 0], X_tr[:, 1], c=y_tr)

plt.scatter(
    X_te[0, 0],
    X_te[0, 1],
    marker='*',
    s=200
)

plt.xlabel('Длина чашелистика')
plt.ylabel('Ширина чашелистика')
plt.title('kNN: ближайшие обучающие цветки')

plt.show()

print("--------------------")

df = pd.read_csv('data/clean.csv')

feats = ['pclass', 'age', 'fare', 'family', 'sex_num']

X_tr, X_te, y_tr, y_te = train_test_split(
    df[feats],
    df['survived'],
    test_size=.25,
    random_state=0
)

lr = LogisticRegression(max_iter=1000).fit(X_tr, y_tr)

print('accuracy:', lr.score(X_te, y_te), 'baseline:', (y_te == 0).mean())

print("--------------------")

pred = lr.predict(X_te)

print(confusion_matrix(y_te, pred))

print(classification_report(y_te, pred))

print("--------------------")

new = pd.DataFrame(
    [[1, 25, 80, 0, 1]],
    columns=feats
)

print(lr.predict(new))

print(lr.predict_proba(new))